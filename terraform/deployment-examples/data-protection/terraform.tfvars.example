###############################################################
# AWS
###############################################################

aws_region = "us-east-1"

###############################################################
# Provider Default Tags
###############################################################

default_tags = {
  Project    = "Zero-Trust"
  Environment = "Development"
  Owner      = "Cloud Team"
  CostCenter = "IT"
}

###############################################################
# KMS Configuration
###############################################################

kms = {
  #########################################################
  # General
  #########################################################

  name        = "enterprise-data-key"
  alias       = "enterprise-data-key"
  description = "Enterprise customer-managed KMS key for data protection."

  #########################################################
  # Cryptography
  #########################################################

  key_spec  = "SYMMETRIC_DEFAULT"
  key_usage = "ENCRYPT_DECRYPT"
  origin    = "AWS_KMS"

  #########################################################
  # Security
  #########################################################

  rotation_enabled        = true
  multi_region            = false
  deletion_window_in_days = 30

  #########################################################
  # Access
  #########################################################

  access = {
    administrators = []

    users = []

    service_principals = [
      "logs.amazonaws.com",
      "cloudtrail.amazonaws.com",
      "s3.amazonaws.com"
    ]
  }

  #########################################################
  # Additional IAM Policy Documents
  #########################################################

  additional_policy_documents = []

  #########################################################
  # Resource Tags
  #########################################################

  tags = {
    Name        = "enterprise-data-key"
    Project     = "Zero-Trust"
    Environment = "Development"
    ManagedBy   = "Terraform"
  }
}
