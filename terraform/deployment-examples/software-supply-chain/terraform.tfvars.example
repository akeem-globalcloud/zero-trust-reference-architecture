# Copy this file to terraform.tfvars and update the values
# before running Terraform.

aws_region = "us-east-1"

# Replace with an accessible GitHub repository URL.
github_repository_url = "https://github.com/akeem-globalcloud/zero-trust-reference-architecture"

github_source_version = "main"

environment = "development"

enable_codebuild = true

# Enable only when the build workflow requires Docker builds.
codebuild_privileged_mode = false

enable_signing_profile = true
